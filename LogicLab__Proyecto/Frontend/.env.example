# Copia como ".env.production" (para el build de producción) y llena la URL.
# Vite lee esta variable al COMPILAR (npm run build), no al ejecutar.
#
# - Con la API en otra dirección:  VITE_API_URL=https://api.midominio.com
# - Con Nginx sirviendo web y API bajo el mismo dominio (/api): déjala vacía:
#   VITE_API_URL=
VITE_API_URL=http://localhost:5030