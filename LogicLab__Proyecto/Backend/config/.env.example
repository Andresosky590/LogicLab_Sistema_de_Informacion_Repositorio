# Copia este archivo como ".env" en esta misma carpeta (Backend/config/) y llena tus datos.
# El archivo ".env" NO se sube a GitHub (ya está en .gitignore).

# "production" en el servidor de AWS; "development" en tu computador.
NODE_ENV=development
PORT=5030
TZ=America/Bogota

# ── Base de datos (en AWS: el punto de enlace de Amazon RDS) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bd_logiclab
DB_POOL_SIZE=10
DB_TIMEZONE=-05:00

# ── Sesiones (JWT): obligatorio en producción. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── CORS: direcciones desde las que el navegador puede llamar a la API,
# separadas por coma. En AWS: http://44.217.81.12
CORS_ORIGINS=

# ── Swagger (/api-docs): en producción solo si pones true
ENABLE_SWAGGER=false

# ── Correo para los códigos de recuperación (contraseña de aplicación de Gmail)
EMAIL_USER=
EMAIL_PASS=